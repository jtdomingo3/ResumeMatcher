# =============================================================================
# AI-Powered Resume Matcher & Career Analyzer - Environment Configuration
# =============================================================================
# DO NOT put real secrets in this file. Copy to .env for local development only.
# In production / desktop mode, prefer storing the API key securely in the
# OS Keyring using: python -m backend.app.cli secrets set-openrouter-key
# =============================================================================

# Server settings
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=8080
ENVIRONMENT=development
LOG_LEVEL=INFO

# OpenRouter Configuration
# Note: Can be left empty if using the OS Keyring via CLI
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini:free
OPENROUTER_HTTP_REFERER=https://resume-matcher.local
OPENROUTER_APP_TITLE="AI Resume Matcher & Career Analyzer"

# RAG & ChromaDB persistence
RAG_DATA_DIR=data/chroma
SQLITE_DB_PATH=data/app.db

# Security & Sessions
# Generate a random 32-byte secret for JWT and session cookies:
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Web Search (DuckDuckGo)
DDG_REGION=wt-wt
DDG_TIMEOUT_SECONDS=6
DDG_MAX_RESULTS=5

# Privacy & PII
MASK_PII_DEFAULT=true
